{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "installCommand": "dnf install -y libxml2-devel libxslt-devel && npm install",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ]
}
